{
  "name": "webgpu-renderer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "benchmark": "vitest bench --run",
    "validate:gpu": "node scripts/validate-gpu.mjs",
    "benchmark:gpu": "node scripts/benchmark-matrix.mjs",
    "format": "prettier --write . && node scripts/format-shaders.mjs",
    "format:check": "prettier --check . && node scripts/format-shaders.mjs --check",
    "profile:animation": "node scripts/profile-animation.mjs",
    "validate:assets": "node scripts/validate-asset-lifecycle.mjs",
    "validate:game": "node scripts/validate-game-api.mjs",
    "validate:hdr": "node scripts/validate-hdr.mjs",
    "validate:features": "node scripts/validate-scene-features.mjs"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.74",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.5.1",
    "ktx-parse": "^2.0.0"
  }
}
